{
  "name": "mise",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "doppler run -- vite dev",
    "build": "vite build",
    "start": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "typecheck": "tsc --noEmit",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "validate": "bun run typecheck && bun run typecheck:convex && bun run lint && bun run knip"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@clerk/tanstack-react-start": "^1.1.0",
    "@convex-dev/react-query": "^0.1.0",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.4.0",
    "@sentry/node": "^10.64.0",
    "@sentry/react": "^10.64.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.27",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "convex": "^1.42.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@sentry/vite-plugin": "^5.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "consola": "^3.4.2",
    "jsdom": "^29.1.1",
    "knip": "^6.26.0",
    "nitro": "^3.0.260429-beta",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=21.0.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
