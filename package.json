{
  "name": "mise",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "doppler run -- vite dev",
    "build": "vite build",
    "start": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "typecheck": "tsc --noEmit",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "validate": "bun run typecheck && bun run typecheck:convex && bun run lint && bun run knip"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/tanstack-react-start": "^1.7.3",
    "@convex-dev/react-query": "^0.1.0",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.9.2",
    "@sentry/node": "^11.8.0",
    "@sentry/react": "^11.8.0",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "convex": "^1.47.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@sentry/vite-plugin": "^5.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "consola": "^3.4.2",
    "jsdom": "^30.1.3",
    "knip": "^6.41.0",
    "nitro": "^3.0.260429-beta",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=21.0.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
